{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "webdriverio": [
        "./node_modules/webdriverio"
      ]
    },
    // WebdriverIO declarations overlap lib.dom and reference optional Puppeteer types.
    // Project source remains strict; only dependency declarations are skipped.
    "skipLibCheck": true
  },
  "include": [
    "test/**/*.ts",
    "src/tauri.d.ts",
    "../../bench/legacy-email/workflow.test.ts"
  ]
}
