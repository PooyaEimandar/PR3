{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR3",
  "version": "0.1.0",
  "identifier": "ai.pooya.pr3",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PR3",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "icon": [
      "icon/32x32.png",
      "icon/128x128.png",
      "icon/128x128@2x.png",
      "icon/icon.icns",
      "icon/icon.ico"
    ]
  }
}
