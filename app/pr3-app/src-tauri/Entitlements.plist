<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS app's entitlements, for the hardened runtime a signed build runs under. -->
<plist version="1.0">
<dict>
  <!-- Voice notes: without it the hardened runtime keeps the microphone silent. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
