# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Private business companion to Roadmap.MD — never commit (the repo is planned to go public)
BUSINESS.md

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Model weights: fetched by script/fetch-model.sh, never committed
/model/

# SwiftPM build output (crate/pr3-vault/swift builds into target/ normally)
.build/

# AgentDojo harness: its virtualenv and raw results
bench/agentdojo/.venv/
bench/agentdojo/result/
__pycache__/

# Task suite: raw results
bench/task/result/

# Fuzzing: corpora and failing inputs are generated (script/fuzz.sh)
fuzz/corpus/
fuzz/artifact/
fuzz/artifacts/
fuzz/coverage/

# The app's webview script, compiled from app/pr3-app/src (npm run build), and its
# compiler
/app/pr3-app/ui/main.js
node_modules/
